resource "azurerm_resource_group" "rg" {
  for_each = toset(var.azure_resource)

  name     = "my-rg-${each.value}"
  location = each.value
}

resource "azurerm_storage_account" "myaccount" {
  for_each = azurerm_resource_group.rg

  name                     = "myfirststorage${each.key}"
  location                 = each.value.location
  resource_group_name      = each.value.name
  account_tier             = "Standard"
  account_replication_type = "LRS"
}

resource "azurerm_storage_container" "mycontainer" {
  for_each = azurerm_storage_account.myaccount

  name                  = "mycontainer"
  storage_account_id    = each.value.id
  container_access_type = "private"
}

resource "azurerm_virtual_network" "vnet" {
  for_each = azurerm_resource_group.rg

  name                = "my-vnet-${each.key}"
  location            = each.value.location
  resource_group_name = each.value.name

  address_space = ["10.0.0.0/16"]
}

resource "azurerm_subnet" "subnet" {
  for_each = azurerm_virtual_network.vnet

  name                 = "my-subnet"
  resource_group_name  = each.value.resource_group_name
  virtual_network_name = each.value.name
  address_prefixes     = ["10.0.1.0/24"]
}

resource "azurerm_network_security_group" "nsg" {
  for_each = azurerm_resource_group.rg

  name                = "my-nsg-${each.key}"
  location            = each.value.location
  resource_group_name = each.value.name
}

resource "azurerm_subnet_network_security_group_association" "subnet_nsg" {
  for_each = azurerm_subnet.subnet

  subnet_id                 = each.value.id
  network_security_group_id = azurerm_network_security_group.nsg[each.key].id
}